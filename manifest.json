{
  "manifest_version": 3,
  "name": "Birdy",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/twitter_logo.png", "images/twitter_logo2.png"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
